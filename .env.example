# GitHub
GITHUB_TOKEN=github_pat_xxx
GITHUB_WEBHOOK_SECRET=choose-a-long-random-string

# Optional: only accept repositories listed here ("owner/repo,owner2/repo2")
ALLOWED_REPOS=

# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# HTTP and working directory
PORT=8787
WORK_DIR=/tmp/ai-fix-github-bot

# Prompt/context limits
MAX_CONTEXT_CHARS=120000
DEEPSEEK_MAX_TOKENS=8000

# Git identity used for the generated commit
GIT_NAME=ai-fix[bot]
GIT_EMAIL=ai-fix[bot]@users.noreply.github.com
