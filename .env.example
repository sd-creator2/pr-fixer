# Optional: only needed when running locally instead of GitHub Actions.
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPOSITORY=owner/repo
PR_NUMBER=1

# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8000
MAX_CONTEXT_CHARS=120000

# Git identity used for the generated commit
GIT_NAME=ai-fix[bot]
GIT_EMAIL=ai-fix[bot]@users.noreply.github.com

# Temporary checkout directory
WORK_DIR=/tmp/ai-fix-github-action
